# Required at both build time and runtime — the Neon Postgres connection string.
DATABASE_URL=

# Required at runtime — HMAC secret for admin/customer session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required at runtime — Telegram bot integration for staff notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Required at build time — baked into the client bundle, so the image must
# be rebuilt if these change.
NEXT_PUBLIC_SITE_URL=https://molly.uz
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional, build time — Google Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=

# Optional, runtime — where uploaded images are written. Defaults to
# public/uploads relative to the app's working directory; the Docker image
# mounts a volume there, so this rarely needs overriding.
UPLOAD_DIR=
